# Liga a camada de mocks (MSW REST + Socket.IO). Mantenha "true" no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST feitas pelo Axios.
VITE_API_URL=/api
# Endereço do servidor Socket.IO (interceptado pelo MSW quando os mocks estão ligados).
VITE_SOCKET_URL=ws://localhost:5173
